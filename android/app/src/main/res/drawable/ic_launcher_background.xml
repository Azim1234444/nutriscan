<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer of the adaptive launcher icon: the two brand greens from
  lib/theme/app_colors.dart (AppColors.primary -> AppColors.primaryDark),
  running top-left to bottom-right.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#1B8A5A"
        android:endColor="#0E5C3A" />
</shape>
