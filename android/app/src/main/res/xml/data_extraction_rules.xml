<?xml version="1.0" encoding="utf-8"?>
<!--
  Read from Android 12 (API 31) onwards.

  android:allowBackup="false" in the manifest already stops cloud backup, but
  from API 31 it no longer covers device-to-device transfer - that channel is
  governed here and here only. Both sections exclude every storage domain, so
  neither one carries app data off the device.

  Nothing is lost by this: the only things NutriScan keeps locally are the
  Firebase Auth session and the Firestore cache, and signing in on the new
  device rebuilds both from the server.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
