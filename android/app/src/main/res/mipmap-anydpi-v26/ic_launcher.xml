<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). Pre-26 devices fall back to the flattened
  mipmap-*/ic_launcher.png, which is this same mark composited onto the brand
  gradient and cut to a rounded square.

  The foreground doubles as the monochrome layer for Android 13+ themed icons:
  it is already a solid white silhouette on transparent, and the system tints
  it using the alpha channel.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
