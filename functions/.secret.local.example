# Copy this file to `.secret.local` and put your own development key in it.
#
# `.secret.local` is what the Functions emulator reads in place of Google
# Secret Manager, and it is git-ignored. The real production key is stored in
# Secret Manager only, with:
#
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Never commit a real key, and never move it into Dart, assets or Android
# resources - it must stay server-side.
GEMINI_API_KEY=replace-with-a-development-key
